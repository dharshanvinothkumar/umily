# ============================================
# UMILY — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# --- Application ---
APP_NAME=Umily
APP_VERSION=0.1.0
DEBUG=true
HOST=127.0.0.1
PORT=8000

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Database ---
DATABASE_URL=sqlite:///./data/umily.db

# --- Voice ---
WAKE_WORD=hey umily

# --- Logging ---
LOG_LEVEL=INFO

# --- Security ---
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
